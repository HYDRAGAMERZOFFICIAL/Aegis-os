# ========================================================================
# AegisOS Production & Development Environment Variables
# ========================================================================
# Node Environment
NODE_ENV=production

# Server Port & Binding (Defaults to 3000 / 0.0.0.0 on cloud hosts)
PORT=3000
HOST=0.0.0.0

# Optional Authentication & Cryptographic Session Key
AEGIS_AUTH_SECRET=aegis_secure_zero_trust_operator_secret_v2
